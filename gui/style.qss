/* RepoScope Notes
 *
 * Notes GitHub Notes #0d1117，Notes #161b22，Notes #30363d，Notes #58a6ff。
 * Notes"Notes"Notes
 * Notes GitHub Notes
 */

QWidget {
    background: #282c34;
    color: #f8f8f2;
    font-family: "Microsoft YaHei UI", "Segoe UI", "PingFang SC", sans-serif;
    font-size: 13px;
}

/* Notes #0d1117 Notes #161b22 Notes
 * Notes"Notes"Notes */
QLabel, QCheckBox, QRadioButton {
    background: transparent;
}

/* ---------- Notes ---------- */
#topbar {
    background: #21252b;
    border-bottom: 1px solid #181a1f;
}

#brand {
    font-size: 15px;
    font-weight: 600;
    color: #f8f8f2;
    letter-spacing: 0.4px;
}

#topbarRepo {
    color: #abb2bf;
    font-size: 12px;
}

#progressbar {
    background: #21252b;
}

/* ---------- Notes ---------- */
#sidebarHost {
    background: #21252b;
    border-right: 1px solid #181a1f;
}

#sidebarHeader {
    background: #21252b;
    border-bottom: 1px solid #181a1f;
}

#sidebarLogo {
    background: #bd93f9;
    color: #282c34;
    border-radius: 5px;
    font-size: 14px;
    font-weight: 700;
    min-width: 26px;
    max-width: 26px;
    min-height: 26px;
    max-height: 26px;
    qproperty-alignment: AlignCenter;
}

#sidebarTitle {
    color: #f8f8f2;
    font-size: 14px;
    font-weight: 600;
}

#sidebarToggle {
    background: transparent;
    border: none;
    padding: 5px;
    border-radius: 4px;
}

#sidebarToggle:hover {
    background: #282c34;
}

#sidebar {
    background: #21252b;
    border: none;
    padding: 8px 8px;
    outline: none;
}

#sidebar::item {
    color: #abb2bf;
    padding: 0 10px;
    border-radius: 5px;
    border-left: 3px solid transparent;
}

#sidebar::item:disabled {
    color: #636d83;
    font-size: 11px;
    padding: 12px 10px 5px;
    letter-spacing: 1px;
}

#sidebar::item:hover:enabled {
    background: #282c34;
    color: #f8f8f2;
}

#sidebar::item:selected {
    background: #3a334b;
    color: #f8f8f2;
    border-left: 3px solid #bd93f9;
    font-weight: 600;
}

/* ---------- Notes ---------- */
#pageTitle {
    font-size: 20px;
    font-weight: 600;
    color: #f8f8f2;
}

#pageHint {
    color: #abb2bf;
    font-size: 12px;
}

#sectionTitle {
    font-size: 13px;
    font-weight: 600;
    color: #f8f8f2;
}

#metricLabel {
    color: #abb2bf;
    font-size: 12px;
}

#metricValue {
    font-size: 26px;
    font-weight: 600;
    color: #f8f8f2;
}

#metricHint {
    color: #636d83;
    font-size: 11px;
}

#healthValue {
    font-size: 34px;
    font-weight: 700;
}

#emptyState {
    color: #636d83;
    font-size: 13px;
    padding: 40px 0;
}

/* ---------- Notes ---------- */
#card {
    background: #21252b;
    border: 1px solid #3a3f4b;
    border-radius: 5px;
}

#riskRow {
    color: #c9d1d9;
    font-size: 12px;
}

#detailMessage {
    color: #c9d1d9;
    font-size: 13px;
}

#formLabel {
    color: #8b949e;
    font-size: 12px;
}

#formValue {
    color: #e6edf3;
    font-size: 13px;
}

#pendingNote {
    color: #EF9F27;
    font-size: 11px;
    background: #2d2210;
    border: 1px solid #5a3f10;
    border-radius: 6px;
    padding: 6px 8px;
}

/* ---------- Notes ---------- */
QPushButton {
    background: #3a3f4b;
    color: #f8f8f2;
    border: 1px solid #4b5263;
    border-radius: 4px;
    padding: 6px 14px;
    font-size: 12px;
}

QPushButton:hover {
    background: #4b5263;
    border-color: #bd93f9;
}

QPushButton:pressed {
    background: #2c313a;
}

QPushButton:disabled {
    color: #636d83;
    background: #2c313a;
    border-color: #3a3f4b;
}

QPushButton#primary {
    background: #50fa7b;
    border-color: #50fa7b;
    color: #282c34;
    font-weight: 600;
}

QPushButton#primary:hover {
    background: #8aff9f;
}

QPushButton#primary:disabled {
    background: #3a5643;
    border-color: #3a5643;
    color: #899393;
}

QPushButton#link {
    background: transparent;
    border: none;
    color: #8be9fd;
    padding: 2px 4px;
}

QPushButton#link:hover {
    color: #a4f2ff;
    text-decoration: underline;
}

/* ---------- Notes ---------- */
QLineEdit, QSpinBox, QComboBox {
    background: #1e2127;
    border: 1px solid #3a3f4b;
    border-radius: 4px;
    padding: 5px 8px;
    color: #f8f8f2;
    selection-background-color: #6d4fa3;
}

QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border-color: #bd93f9;
}

QComboBox::drop-down {
    border: none;
    width: 18px;
}

QComboBox QAbstractItemView {
    background: #21252b;
    border: 1px solid #3a3f4b;
    selection-background-color: #6d4fa3;
    color: #f8f8f2;
}

/* ---------- Notes ---------- */
QProgressBar {
    background: #3a3f4b;
    border: none;
    border-radius: 3px;
    height: 6px;
    text-align: center;
}

QProgressBar::chunk {
    background: #50fa7b;
    border-radius: 3px;
}

/* ---------- Notes / Notes ---------- */
QTableView {
    background: #1e2127;
    alternate-background-color: #21252b;
    border: 1px solid #3a3f4b;
    border-radius: 6px;
    gridline-color: #2c313a;
    selection-background-color: #6d4fa3;
    selection-color: #ffffff;
}

QTableView::item {
    padding: 4px 6px;
    border-bottom: 1px solid #2c313a;
}

QHeaderView::section {
    background: #21252b;
    color: #abb2bf;
    border: none;
    border-bottom: 1px solid #3a3f4b;
    padding: 6px 8px;
    font-size: 12px;
}

QListWidget {
    background: #1e2127;
    border: 1px solid #3a3f4b;
    border-radius: 4px;
    outline: none;
}

QListWidget::item {
    padding: 6px 8px;
    border-bottom: 1px solid #161b22;
}

QListWidget::item:selected {
    background: #6d4fa3;
    color: #ffffff;
}

#recentList::item {
    color: #8b949e;
}

#patternList::item {
    color: #c9d1d9;
    font-size: 12px;
}

/* ---------- Notes ---------- */
QTabWidget::pane {
    border: 1px solid #21262d;
    border-radius: 6px;
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    color: #8b949e;
    padding: 7px 16px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 12px;
}

QTabBar::tab:selected {
    color: #e6edf3;
    border-bottom: 2px solid #58a6ff;
}

QTabBar::tab:hover {
    color: #c9d1d9;
}

/* ---------- report ---------- */
#reportPreview, #reportSource {
    background: #0d1117;
    border: 1px solid #21262d;
    border-radius: 6px;
    padding: 12px;
    color: #c9d1d9;
    font-size: 12px;
}

#reportSource {
    font-family: "Cascadia Mono", "Consolas", monospace;
    color: #8b949e;
}

/* ---------- Notes ---------- */
#heatmap {
    border: none;
    background: transparent;
}

#heatmap::item {
    border: 1px solid #0d1117;
    border-radius: 2px;
}

/* ---------- Notes ---------- */
QScrollArea {
    border: none;
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #30363d;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #484f58;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
}

QScrollBar::handle:horizontal {
    background: #30363d;
    border-radius: 5px;
    min-width: 24px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QSplitter::handle {
    background: #21262d;
}

QSplitter::handle:horizontal {
    width: 6px;
}

QStatusBar {
    background: #010409;
    color: #6e7681;
    border-top: 1px solid #21262d;
    font-size: 11px;
}

QToolTip {
    background: #161b22;
    color: #c9d1d9;
    border: 1px solid #30363d;
    padding: 4px 6px;
}



