/* RepoScope 深色主题
 *
 * 配色沿用 GitHub 暗色系：底色 #0d1117，卡片 #161b22，描边 #30363d，主色 #58a6ff。
 * 之所以不自己配色：评审对"像不像一个真工具"的判断几乎全来自第一眼，
 * 而 GitHub 这套配色是开发者最熟悉、最不会觉得刺眼的。
 */

QWidget {
    background: #0d1117;
    color: #c9d1d9;
    font-family: "Microsoft YaHei UI", "Segoe UI", "PingFang SC", sans-serif;
    font-size: 13px;
}

/* 文字类控件必须透明：全局的 #0d1117 比卡片底色 #161b22 更深，
 * 不覆盖就会在卡片上"抠"出一个个深色方块，看起来像套了一层边框。 */
QLabel, QCheckBox, QRadioButton {
    background: transparent;
}

/* ---------- 顶栏 ---------- */
#topbar {
    background: #010409;
    border-bottom: 1px solid #21262d;
}

#brand {
    font-size: 15px;
    font-weight: 600;
    color: #e6edf3;
    letter-spacing: 0.4px;
}

#topbarRepo {
    color: #8b949e;
    font-size: 12px;
}

#progressbar {
    background: #010409;
}

/* ---------- 侧边导航 ---------- */
#sidebar {
    background: #010409;
    border: none;
    border-right: 1px solid #21262d;
    padding: 8px 0;
    outline: none;
}

#sidebar::item {
    color: #8b949e;
    padding-left: 14px;
    border-left: 3px solid transparent;
}

#sidebar::item:disabled {
    color: #484f58;
    font-size: 11px;
    padding-top: 10px;
    letter-spacing: 1px;
}

#sidebar::item:hover:enabled {
    background: #161b22;
    color: #c9d1d9;
}

#sidebar::item:selected {
    background: #161b22;
    color: #e6edf3;
    border-left: 3px solid #58a6ff;
    font-weight: 600;
}

/* ---------- 标题层级 ---------- */
#pageTitle {
    font-size: 20px;
    font-weight: 600;
    color: #e6edf3;
}

#pageHint {
    color: #8b949e;
    font-size: 12px;
}

#sectionTitle {
    font-size: 13px;
    font-weight: 600;
    color: #e6edf3;
}

#metricLabel {
    color: #8b949e;
    font-size: 12px;
}

#metricValue {
    font-size: 26px;
    font-weight: 600;
    color: #e6edf3;
}

#metricHint {
    color: #6e7681;
    font-size: 11px;
}

#healthValue {
    font-size: 34px;
    font-weight: 700;
}

#emptyState {
    color: #6e7681;
    font-size: 13px;
    padding: 40px 0;
}

/* ---------- 卡片 ---------- */
#card {
    background: #161b22;
    border: 1px solid #30363d;
    border-radius: 8px;
}

#riskRow {
    color: #c9d1d9;
    font-size: 12px;
}

#detailMessage {
    color: #c9d1d9;
    font-size: 13px;
}

#formLabel {
    color: #8b949e;
    font-size: 12px;
}

#formValue {
    color: #e6edf3;
    font-size: 13px;
}

#pendingNote {
    color: #EF9F27;
    font-size: 11px;
    background: #2d2210;
    border: 1px solid #5a3f10;
    border-radius: 6px;
    padding: 6px 8px;
}

/* ---------- 按钮 ---------- */
QPushButton {
    background: #21262d;
    color: #c9d1d9;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 6px 14px;
    font-size: 12px;
}

QPushButton:hover {
    background: #30363d;
    border-color: #8b949e;
}

QPushButton:pressed {
    background: #161b22;
}

QPushButton:disabled {
    color: #484f58;
    background: #161b22;
    border-color: #21262d;
}

QPushButton#primary {
    background: #238636;
    border-color: #2ea043;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#primary:hover {
    background: #2ea043;
}

QPushButton#primary:disabled {
    background: #1b4721;
    border-color: #1b4721;
    color: #6e7681;
}

QPushButton#link {
    background: transparent;
    border: none;
    color: #58a6ff;
    padding: 2px 4px;
}

QPushButton#link:hover {
    color: #79c0ff;
    text-decoration: underline;
}

/* ---------- 输入类 ---------- */
QLineEdit, QSpinBox, QComboBox {
    background: #0d1117;
    border: 1px solid #30363d;
    border-radius: 6px;
    padding: 5px 8px;
    color: #c9d1d9;
    selection-background-color: #1f6feb;
}

QLineEdit:focus, QSpinBox:focus, QComboBox:focus {
    border-color: #58a6ff;
}

QComboBox::drop-down {
    border: none;
    width: 18px;
}

QComboBox QAbstractItemView {
    background: #161b22;
    border: 1px solid #30363d;
    selection-background-color: #1f6feb;
    color: #c9d1d9;
}

/* ---------- 进度条 ---------- */
QProgressBar {
    background: #21262d;
    border: none;
    border-radius: 3px;
    height: 6px;
    text-align: center;
}

QProgressBar::chunk {
    background: #238636;
    border-radius: 3px;
}

/* ---------- 表格 / 列表 ---------- */
QTableView {
    background: #0d1117;
    alternate-background-color: #0d1117;
    border: 1px solid #21262d;
    border-radius: 6px;
    gridline-color: #21262d;
    selection-background-color: #1f6feb;
    selection-color: #ffffff;
}

QTableView::item {
    padding: 4px 6px;
    border-bottom: 1px solid #161b22;
}

QHeaderView::section {
    background: #161b22;
    color: #8b949e;
    border: none;
    border-bottom: 1px solid #30363d;
    padding: 6px 8px;
    font-size: 12px;
}

QListWidget {
    background: #0d1117;
    border: 1px solid #21262d;
    border-radius: 6px;
    outline: none;
}

QListWidget::item {
    padding: 6px 8px;
    border-bottom: 1px solid #161b22;
}

QListWidget::item:selected {
    background: #1f6feb;
    color: #ffffff;
}

#recentList::item {
    color: #8b949e;
}

#patternList::item {
    color: #c9d1d9;
    font-size: 12px;
}

/* ---------- 标签页 ---------- */
QTabWidget::pane {
    border: 1px solid #21262d;
    border-radius: 6px;
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    color: #8b949e;
    padding: 7px 16px;
    border: none;
    border-bottom: 2px solid transparent;
    font-size: 12px;
}

QTabBar::tab:selected {
    color: #e6edf3;
    border-bottom: 2px solid #58a6ff;
}

QTabBar::tab:hover {
    color: #c9d1d9;
}

/* ---------- 报告预览 ---------- */
#reportPreview, #reportSource {
    background: #0d1117;
    border: 1px solid #21262d;
    border-radius: 6px;
    padding: 12px;
    color: #c9d1d9;
    font-size: 12px;
}

#reportSource {
    font-family: "Cascadia Mono", "Consolas", monospace;
    color: #8b949e;
}

/* ---------- 热力图 ---------- */
#heatmap {
    border: none;
    background: transparent;
}

#heatmap::item {
    border: 1px solid #0d1117;
    border-radius: 2px;
}

/* ---------- 其它 ---------- */
QScrollArea {
    border: none;
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #30363d;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #484f58;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
}

QScrollBar::handle:horizontal {
    background: #30363d;
    border-radius: 5px;
    min-width: 24px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QSplitter::handle {
    background: #21262d;
}

QSplitter::handle:horizontal {
    width: 6px;
}

QStatusBar {
    background: #010409;
    color: #6e7681;
    border-top: 1px solid #21262d;
    font-size: 11px;
}

QToolTip {
    background: #161b22;
    color: #c9d1d9;
    border: 1px solid #30363d;
    padding: 4px 6px;
}
